{
  "name": "organization-management",
  "version": "1.0.0",
  "description": "Organization Management system built with TypeScript OOP (CRUD + hierarchy validation).",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "npm run build --silent && node dist/src/index.js",
    "demo:seed": "npm start --silent -- seed",
    "demo:create": "npm start --silent -- create",
    "demo:read": "npm start --silent -- read",
    "demo:update": "npm start --silent -- update",
    "demo:delete": "npm start --silent -- delete",
    "demo:validate": "npm start --silent -- validate",
    "test": "npm run build --silent && node --test \"dist/tests/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "oop",
    "organization"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22"
  }
}
